rules_version = '2';

// Bin documents use a string document ID and contain name/type/status strings,
// integer fill percentage, GeoPoint location, and optional timestamp emptied
// and maintenanceNote string fields.
service cloud.firestore {
  match /databases/{database}/documents {
    // Add admins/{uid} with enabled: true for each admin account.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'test@gmail.com'
          || request.auth.token.admin == true
          || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true));
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['co2SavedKg'])
        && request.resource.data.keys().hasAll(['co2SavedKg'])
        && request.resource.data.co2SavedKg is number
        && request.resource.data.co2SavedKg == 0;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /notificationDevices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'location',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.pushEnabled is bool
          && request.resource.data.binAlertsEnabled is bool
          && request.resource.data.enabled is bool
          && request.resource.data.enabled
            == (request.resource.data.pushEnabled
              && request.resource.data.binAlertsEnabled)
          && request.resource.data.updatedAt is timestamp
          && (!('location' in request.resource.data)
            || request.resource.data.location is latlng);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'location',
            'updatedAt',
            'lastAlertedBinId'
          ])
          && request.resource.data.keys().hasAll([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.pushEnabled is bool
          && request.resource.data.binAlertsEnabled is bool
          && request.resource.data.enabled is bool
          && request.resource.data.enabled
            == (request.resource.data.pushEnabled
              && request.resource.data.binAlertsEnabled)
          && request.resource.data.updatedAt is timestamp
          && (!('location' in request.resource.data)
            || request.resource.data.location is latlng)
          && request.resource.data.get('lastAlertedBinId', null)
            == resource.data.get('lastAlertedBinId', null);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedAddresses/{addressId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.location is latlng
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.location is latlng
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedListings/{listingId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /bins/{binId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'in_progress', 'resolved', 'rejected'];
    }

    match /listings/{listingId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'condition', 'price', 'description', 'seller',
          'ownerId', 'status', 'distance', 'pickupAddress', 'imageUrls',
          'photoCount', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if (request.auth != null
          && resource.data.ownerId == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status in ['pending', 'pending_review', 'sold', 'hidden']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aiScore', 'aiLabel'])
          && request.resource.data.status in ['pending', 'pending_review', 'active', 'rejected', 'sold', 'hidden']
          && (!('aiScore' in request.resource.data)
            || (request.resource.data.aiScore is number
              && request.resource.data.aiScore >= 0
              && request.resource.data.aiScore <= 1))
          && (!('aiLabel' in request.resource.data)
            || request.resource.data.aiLabel in ['allowed', 'review']));
      allow delete: if (request.auth != null
          && resource.data.ownerId == request.auth.uid)
        || (isAdmin()
          && resource.data.status in ['hidden', 'sold', 'rejected']);
    }

    match /offers/{offerId} {
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow get, list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && (resource.data.sellerId == request.auth.uid
          || resource.data.buyerId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId == request.auth.uid
            || get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
            || request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.system == true
            || getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.status != 'closed')
          && (getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId == request.auth.uid
            || getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
            || request.auth.uid in getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants);
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
