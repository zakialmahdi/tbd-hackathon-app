rules_version = '2';

// Bin documents use a string document ID and contain name/type/status strings,
// integer fill percentage, GeoPoint location, and optional timestamp emptied
// and maintenanceNote string fields.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['co2SavedKg'])
        && request.resource.data.keys().hasAll(['co2SavedKg'])
        && request.resource.data.co2SavedKg is number
        && request.resource.data.co2SavedKg == 0;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /notificationDevices/{deviceId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
        /* Detailed validation is handled by the notification service. */
        /* The broad owner rule keeps server timestamp/delete transforms valid. */
        /* More specific rules below remain as documentation of the schema. */
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'location',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.pushEnabled is bool
          && request.resource.data.binAlertsEnabled is bool
          && request.resource.data.enabled is bool
          && request.resource.data.enabled
            == (request.resource.data.pushEnabled
              && request.resource.data.binAlertsEnabled)
          && request.resource.data.updatedAt is timestamp
          && (!('location' in request.resource.data)
            || request.resource.data.location is latlng);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'location',
            'updatedAt',
            'lastAlertedBinId'
          ])
          && request.resource.data.keys().hasAll([
            'token',
            'pushEnabled',
            'binAlertsEnabled',
            'enabled',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.pushEnabled is bool
          && request.resource.data.binAlertsEnabled is bool
          && request.resource.data.enabled is bool
          && request.resource.data.enabled
            == (request.resource.data.pushEnabled
              && request.resource.data.binAlertsEnabled)
          && request.resource.data.updatedAt is timestamp
          && (!('location' in request.resource.data)
            || request.resource.data.location is latlng)
          && request.resource.data.get('lastAlertedBinId', null)
            == resource.data.get('lastAlertedBinId', null);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedAddresses/{addressId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.location is latlng
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'address',
            'location',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.location is latlng
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedListings/{listingId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /bins/{binId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /listings/{listingId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'condition', 'price', 'description', 'seller',
          'ownerId', 'status', 'distance', 'pickupAddress', 'imageUrls',
          'photoCount', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /offers/{offerId} {
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow get, list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && (resource.data.sellerId == request.auth.uid
          || resource.data.buyerId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId == request.auth.uid
            || get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
            || request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.system == true
            || getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.status != 'closed')
          && (getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId == request.auth.uid
            || getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
            || request.auth.uid in getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
